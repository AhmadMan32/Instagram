{
  "expo": {
    "name": "Insta Bildirim Arşivi",
    "slug": "instagram-notification-archive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "instagram-notification-archive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.replit.instabildirimarsivi",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router", "./plugins/withNotificationArchive"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
